#!/usr/bin/env bash

set -euo pipefail

parseargs() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --init-time)   init_time="$2"   ;;
      --fcst-length) fcst_length="$2" ;;
      --ensembles)   ensembles="$2"   ;;
      --gpus)        gpus="$2"        ;;
      --account)     account="$2"     ;;
      *)             usage            ;;
    esac
    shift 2
  done
  for var in init_time fcst_length ensembles gpus account; do
    if [[ -z "${!var:-}" ]]; then
      usage
    fi
  done
}

usage() {
  cat <<EOF >&2
Usage: $(basename "$0") --init-time VALUE --fcst-length VALUE --ensembles VALUE --gpus VALUE --account VALUE

Required switches:
  --init-time   Initialization time in YYYY-MM-DDTHH format
  --fcst-length Forecast length as an integer
  --ensembles   Number of ensembles
  --gpus        Number of GPUs
  --account     Account name
EOF
  exit 1
}

parseargs $@

echo "init-time:   $init_time"
echo "fcst-length: $fcst_length"
echo "ensembles:   $ensembles"
echo "gpus:        $gpus"
echo "account:     $account"
