#!/usr/bin/env bash

set -euo pipefail

getdata() {
  local args missing
  args=(
    -c config.yaml
    --key-path data
    --cycle $init_time
    --leadtime $fcst_length
    --thread 8
    --report
  )
  uw fs copy ${args[*]} | jq -e 'select(."not-ready" == [])' >/dev/null
}

parseargs() {
  local var
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --init-time)   init_time="$2"   ;;
      --fcst-length) fcst_length="$2" ;;
      --ensembles)   ensembles="$2"   ;;
      --gpus)        gpus="$2"        ;;
      --account)     account="$2"     ;;
      *)             usage            ;;
    esac
    shift 2
  done
  for var in init_time fcst_length; do # ensembles gpus account
    if [[ -z "${!var:-}" ]]; then
      usage
    fi
  done
}

usage() {
  cat <<EOF >&2
Usage: $(basename "$0") --init-time VALUE --fcst-length VALUE --ensembles VALUE --gpus VALUE --account VALUE

Required settings:
  --init-time   Initialization time in YYYY-MM-DDTHH format
  --fcst-length Forecast length as an integer
EOF
  exit 1
#   --ensembles   Number of ensembles
#   --gpus        Number of GPUs
#   --account     Account name
}

parseargs $@
getdata
